{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voice Desk",
  "version": "0.1.0",
  "identifier": "br.com.going2.voicedesk",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "principal", "visible": false, "title": "Voice Desk", "url": "index.html", "width": 1100, "height": 760, "minWidth": 720, "minHeight": 520 }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
