{
  "name": "voice-desk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.4.0",
  "scripts": {
    "dev": "vite",
    "dev:simulado": "cross-env VITE_IPC=simulado vite",
    "build": "tsc --noEmit && vite build",
    "build:simulado": "cross-env VITE_IPC=simulado vite build",
    "preview:simulado": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome ci",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "@tauri-apps/api": "~2.12.0",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "react-router": "~8.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "~2.12.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "cross-env": "^10.1.0",
    "jsdom": "^30.1.0",
    "typescript": "~7.0.2",
    "vite": "~8.3.5",
    "vitest": "~5.0.5"
  }
}
